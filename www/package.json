    "react-docgen": "^8.0.4",
    "react-dom": "19.2.5",
    "react-instantsearch": "^7.13.6",
    "react-markdown": "^9.0.1",
    "react-medium-image-zoom": "^5.2.10",
    "react-tooltip": "^5.28.0",
    "react-transition-group": "^4.4.5",
    "react-uuid": "^2.0.0",
    "rehype-mdx-code-props": "^3.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
