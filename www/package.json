    "@medusajs/icons": "2.22.5",
    "@medusajs/ui": "4.2.12",
    "@medusajs/ui-preset": "2.22.5",
    "@react-hook/resize-observer": "^1.2.6",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@types/mdx": "^2.0.14",
    "@uidotdev/usehooks": "^2.4.1",
    "algoliasearch": "^5.64.0",
    "astro": "^5.14.0",
    "autoprefixer": "^10.4.14",
    "clsx": "^2.1.0",
    "fdir": "^6.5.0",
    "framer-motion": "^11.11.9",
