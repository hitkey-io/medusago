---
import "~/styles/globals.css"
import HomeApp from "~/components/HomeApp"
---
<html lang="en" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <!-- the stored theme, before the first paint (the React provider reads it again once the page is interactive) -->
    <script is:inline>
      try {
        var theme = localStorage.getItem("theme")
        document.documentElement.setAttribute("data-theme", theme === "dark" ? "dark" : "light")
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101215" />
    <title>MedusaGo Documentation</title>
    <meta name="description" content="Documentation of MedusaGo, the Go implementation of the Medusa commerce backend." />
    <link rel="canonical" href="https://medusago.hitkey.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MedusaGo" />
    <meta property="og:title" content="MedusaGo Documentation" />
    <meta property="og:description" content="Documentation of MedusaGo, the Go implementation of the Medusa commerce backend." />
    <meta property="og:url" content="https://medusago.hitkey.io/" />
    <meta property="og:image" content="https://medusago.hitkey.io/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MedusaGo Documentation" />
    <meta name="twitter:description" content="Documentation of MedusaGo, the Go implementation of the Medusa commerce backend." />
    <meta name="twitter:image" content="https://medusago.hitkey.io/og.png" />
  </head>
  <body class="h-screen w-full overflow-hidden">
    <HomeApp client:load />
  </body>
</html>
