---
import "~/styles/globals.css"
import PageApp from "~/components/PageApp"
import { sections, type SectionKey } from "~/config/sections"

export function getStaticPaths() {
  const files = import.meta.glob("/content/**/page.mdx")
  return Object.keys(files).map((file) => {
    const [, , section, ...rest] = file.split("/")
    rest.pop() // page.mdx
    return {
      params: { path: [section, ...rest].join("/") },
      props: { file, section },
    }
  })
}

const loaders = import.meta.glob("/content/**/page.mdx") as Record<string, () => Promise<{ default: unknown }>>
const cache = ((globalThis as any).__PAGE_CACHE__ ||= new Map())
if (!cache.has(Astro.props.file)) cache.set(Astro.props.file, (await loaders[Astro.props.file]()).default)

const { file, section } = Astro.props as { file: string; section: SectionKey }
const path = "/" + Astro.params.path
const config = sections[section]
const site = "https://medusago.hitkey.io"
const canonical = site + path + "/"
const ogImage = site + "/og.png"
---
<html lang="en" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101215" />
    <title>{config.titleSuffix}</title>
    <meta name="description" content={config.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MedusaGo" />
    <meta property="og:title" content={config.titleSuffix} />
    <meta property="og:description" content={config.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={config.titleSuffix} />
    <meta name="twitter:description" content={config.description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="h-screen w-full overflow-hidden">
    <PageApp client:load file={file} section={section} path={path} />
  </body>
</html>
