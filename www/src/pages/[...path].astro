---
import "~/styles/globals.css"
import PageApp from "~/components/PageApp"
import { sections, type SectionKey } from "~/config/sections"

export function getStaticPaths() {
  const files = import.meta.glob("/content/**/page.mdx")
  return Object.keys(files).map((file) => {
    const [, , section, ...rest] = file.split("/")
    rest.pop() // page.mdx
    return {
      params: { path: [section, ...rest].join("/") },
      props: { file, section },
    }
  })
}

const { file, section } = Astro.props as { file: string; section: SectionKey }
const path = "/" + Astro.params.path
const config = sections[section]
---
<html lang="en" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101215" />
    <title>{config.titleSuffix}</title>
  </head>
  <body class="h-screen w-full overflow-hidden">
    <PageApp client:load file={file} section={section} path={path} />
  </body>
</html>
