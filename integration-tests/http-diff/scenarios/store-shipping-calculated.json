[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "locations",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/stock-locations?fields=id"
  },
  {
    "name": "profiles",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/shipping-profiles?fields=id"
  },
  {
    "name": "fs",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id",
    "body": {
      "name": "EU",
      "type": "shipping"
    }
  },
  {
    "name": "zone",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id",
    "body": {
      "name": "Germany",
      "geo_zones": [
        {
          "type": "country",
          "country_code": "de"
        }
      ]
    }
  },
  {
    "name": "link_provider",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id",
    "body": {
      "add": [
        "manual_manual",
        "test-calculated_calc"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "so_std",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Standard",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Standard",
        "code": "standard",
        "description": "3-5 days"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 5
        },
        {
          "region_id": "{{regions.regions.0.id}}",
          "amount": 4.5
        }
      ],
      "rules": [
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        },
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        }
      ]
    }
  },
  {
    "name": "so_return",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Return",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Return",
        "code": "return"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 7
        }
      ],
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "true"
        }
      ]
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "register",
    "method": "POST",
    "path": "/auth/customer/emailpass/register",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "customer",
    "method": "POST",
    "path": "/store/customers?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "email": "buyer@example.test",
      "first_name": "Test",
      "last_name": "Buyer"
    },
    "bearer": "register"
  },
  {
    "name": "customer_login",
    "method": "POST",
    "path": "/auth/customer/emailpass",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "providers",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/fulfillment-providers?order=id&fields=id,is_enabled"
  },
  {
    "name": "provider_options",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/fulfillment-providers/test-calculated_calc/options"
  },
  {
    "name": "so_manual_calc",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Manual Calculated",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "calculated",
      "provider_id": "manual_manual",
      "prices": [],
      "type": {
        "label": "Manual Calculated",
        "code": "manual-calculated"
      },
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        },
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        }
      ]
    }
  },
  {
    "name": "so_calc",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id,name,price_type,data,provider_id",
    "body": {
      "name": "Calculated",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "calculated",
      "provider_id": "test-calculated_calc",
      "prices": [],
      "type": {
        "label": "Calculated",
        "code": "calculated"
      },
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        },
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        }
      ],
      "data": {
        "base": 4
      }
    }
  },
  {
    "name": "so_calc_return",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Calculated Return",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "calculated",
      "provider_id": "test-calculated_calc",
      "prices": [],
      "type": {
        "label": "Calculated Return",
        "code": "calculated-return"
      },
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "true"
        },
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        }
      ],
      "data": {
        "base": 2
      }
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "first_name": "Test",
        "last_name": "Buyer",
        "address_1": "Example Street 1",
        "country_code": "de",
        "city": "Berlin",
        "postal_code": "10115"
      },
      "billing_address": {
        "country_code": "de",
        "city": "Berlin"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        }
      ]
    },
    "bearer": "customer_login"
  },
  {
    "name": "options",
    "method": "GET",
    "path": "/store/shipping-options?cart_id={{cart.cart.id}}&fields=id,name,price_type,amount,is_tax_inclusive,calculated_price.*",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "sortby": {
      "shipping_options": "name"
    }
  },
  {
    "name": "calculate",
    "method": "POST",
    "path": "/store/shipping-options/{{so_calc.shipping_option.id}}/calculate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "cart_id": "{{cart.cart.id}}",
      "data": {
        "extra": 2
      }
    }
  },
  {
    "name": "add_fail",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_calc.shipping_option.id}}",
      "data": {
        "fail": true
      }
    },
    "bearer": "customer_login"
  },
  {
    "name": "add_calc",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id,total,shipping_total,shipping_methods.amount,shipping_methods.data,shipping_methods.name,shipping_methods.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_calc.shipping_option.id}}",
      "data": {
        "extra": 1
      }
    },
    "bearer": "customer_login"
  },
  {
    "name": "update_qty",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{cart.cart.items.0.id}}?fields=id,total,shipping_methods.amount",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 3
    },
    "bearer": "customer_login"
  },
  {
    "name": "pc",
    "method": "POST",
    "path": "/store/payment-collections?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "cart_id": "{{cart.cart.id}}"
    },
    "bearer": "customer_login"
  },
  {
    "name": "session",
    "method": "POST",
    "path": "/store/payment-collections/{{pc.payment_collection.id}}/payment-sessions?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "provider_id": "pp_system_default"
    },
    "bearer": "customer_login"
  },
  {
    "name": "complete",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/complete?fields=id,items.id,shipping_methods.amount,shipping_methods.data",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {},
    "bearer": "customer_login"
  },
  {
    "name": "fulfill",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}/fulfillments?fields=id,fulfillments.data,fulfillments.provider_id",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 3
        }
      ]
    }
  },
  {
    "name": "return_begin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns?fields=id",
    "body": {
      "order_id": "{{complete.order.id}}"
    }
  },
  {
    "name": "return_items",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{return_begin.return.id}}/request-items?fields=id",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "return_shipping",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{return_begin.return.id}}/shipping-method",
    "body": {
      "shipping_option_id": "{{so_calc_return.shipping_option.id}}"
    }
  },
  {
    "name": "return_items2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{return_begin.return.id}}/request-items",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "return_cancel",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/returns/{{return_begin.return.id}}/request"
  },
  {
    "name": "edit_begin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/order-edits?fields=id",
    "body": {
      "order_id": "{{complete.order.id}}"
    }
  },
  {
    "name": "edit_shipping",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/order-edits/{{complete.order.id}}/shipping-method",
    "body": {
      "shipping_option_id": "{{so_calc.shipping_option.id}}"
    }
  },
  {
    "name": "edit_cancel",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/order-edits/{{complete.order.id}}"
  },
  {
    "name": "draft_customer",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/customers?email=alice@example.test&fields=id"
  },
  {
    "name": "draft",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders?fields=id,shipping_methods.amount",
    "body": {
      "email": "alice@example.test",
      "customer_id": "{{draft_customer.customers.0.id}}",
      "region_id": "{{regions.regions.0.id}}",
      "sales_channel_id": "{{channels.sales_channels.0.id}}",
      "shipping_address": {
        "first_name": "Draft",
        "last_name": "Buyer",
        "address_1": "Example Street 2",
        "country_code": "de",
        "city": "Berlin",
        "postal_code": "10117"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "draft_begin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}/edit"
  },
  {
    "name": "draft_shipping",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}/edit/shipping-methods",
    "body": {
      "shipping_option_id": "{{so_calc.shipping_option.id}}"
    }
  },
  {
    "name": "draft_items",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}/edit/items",
    "body": {
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        }
      ]
    }
  },
  {
    "name": "draft_confirm",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}/edit/confirm"
  },
  {
    "name": "draft_after",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}?fields=id,total,shipping_total,shipping_methods.amount,shipping_methods.name,items.quantity"
  },
  {
    "name": "draft_update",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/draft-orders/{{draft.draft_order.id}}?fields=id,shipping_methods.amount",
    "body": {
      "shipping_address": {
        "first_name": "Draft",
        "last_name": "Buyer",
        "address_1": "Example Street 3",
        "country_code": "de",
        "city": "Berlin",
        "postal_code": "10117"
      }
    }
  }
]
