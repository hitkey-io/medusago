[
  {"name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": {"email": "admin@medusa-test.com", "password": "supersecret"}},
  {"name": "pk", "method": "POST", "bearer": "login", "path": "/admin/api-keys", "body": {"title": "Store", "type": "publishable"}},
  {"name": "channels", "method": "GET", "bearer": "login", "path": "/admin/sales-channels?order=name&fields=id,name"},
  {"name": "link", "method": "POST", "bearer": "login", "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id", "body": {"add": ["{{channels.sales_channels.0.id}}"]}},
  {"name": "locations", "method": "GET", "bearer": "login", "path": "/admin/stock-locations?fields=id"},
  {"name": "profiles", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles?fields=id"},
  {"name": "fs", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id", "body": {"name": "EU", "type": "shipping"}},
  {"name": "zone", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id", "body": {"name": "Germany", "geo_zones": [{"type": "country", "country_code": "de"}]}},
  {"name": "link_provider", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id", "body": {"add": ["manual_manual"]}},
  {"name": "regions", "method": "GET", "path": "/store/regions?order=name&fields=id,name", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "so_std", "method": "POST", "bearer": "login", "path": "/admin/shipping-options?fields=id", "body": {"name": "Standard", "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type": {"label": "Standard", "code": "standard", "description": "3-5 days"}, "prices": [{"currency_code": "eur", "amount": 5}, {"region_id": "{{regions.regions.0.id}}", "amount": 4.5}], "rules": [{"attribute": "enabled_in_store", "operator": "eq", "value": "true"}, {"attribute": "is_return", "operator": "eq", "value": "false"}]}},
  {"name": "products", "method": "GET", "path": "/store/products?fields=id,title,variants.id&order=title", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "so", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/{{so_std.shipping_option.id}}?fields=id,name,type.id,type.label"},
  {"name": "so_fr", "method": "POST", "bearer": "login", "path": "/admin/translations/batch", "body": {"create": [{"reference_id": "{{so_std.shipping_option.id}}", "reference": "shipping_option", "locale_code": "fr-FR", "translations": {"name": "Livraison standard"}}]}},
  {"name": "so_type_fr", "method": "POST", "bearer": "login", "path": "/admin/translations/batch", "body": {"create": [{"reference_id": "{{so.shipping_option.type.id}}", "reference": "shipping_option_type", "locale_code": "fr-FR", "translations": {"label": "Standard FR", "description": "3-5 jours"}}]}},
  {"name": "cart_fr", "method": "POST", "path": "/store/carts?fields=id,locale", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"region_id": "{{regions.regions.0.id}}", "locale": "fr-FR", "shipping_address": {"country_code": "de", "city": "Berlin"}, "items": [{"variant_id": "{{products.products.1.variants.0.id}}", "quantity": 1}]}},
  {"name": "cart_plain", "method": "POST", "path": "/store/carts?fields=id,locale", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"region_id": "{{regions.regions.0.id}}", "shipping_address": {"country_code": "de", "city": "Berlin"}, "items": [{"variant_id": "{{products.products.1.variants.0.id}}", "quantity": 1}]}},
  {"name": "options_fr", "method": "GET", "path": "/store/shipping-options?cart_id={{cart_fr.cart.id}}", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "options_fr_fields", "method": "GET", "path": "/store/shipping-options?cart_id={{cart_fr.cart.id}}&fields=id,name,type.label,type.description", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "options_plain", "method": "GET", "path": "/store/shipping-options?cart_id={{cart_plain.cart.id}}&fields=id,name,type.label", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "options_query_locale_ignored", "method": "GET", "path": "/store/shipping-options?cart_id={{cart_plain.cart.id}}&locale=fr-FR&fields=id,name", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "add_method", "method": "POST", "path": "/store/carts/{{cart_fr.cart.id}}/shipping-methods?fields=id,shipping_methods.name,shipping_methods.description", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"option_id": "{{so_std.shipping_option.id}}"}}
]
