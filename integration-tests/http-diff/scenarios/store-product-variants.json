[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "pk2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Two channels",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "link2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk2.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}",
        "{{channels.sales_channels.1.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list",
    "method": "GET",
    "path": "/store/product-variants",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_two",
    "method": "GET",
    "path": "/store/product-variants?fields=id,sku&sales_channel_id={{channels.sales_channels.1.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk2.api_key.token}}"
    }
  },
  {
    "name": "list_sku",
    "method": "GET",
    "path": "/store/product-variants?sku=PANTS-L&fields=id,sku,product.title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_q",
    "method": "GET",
    "path": "/store/product-variants?q=white&fields=id,title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_backorder",
    "method": "GET",
    "path": "/store/product-variants?allow_backorder=true&fields=id,title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_order",
    "method": "GET",
    "path": "/store/product-variants?order=-sku&limit=2&offset=1&fields=id,sku",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_prices",
    "method": "GET",
    "path": "/store/product-variants?fields=id,sku,calculated_price&region_id={{regions.regions.0.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_prices_no_region",
    "method": "GET",
    "path": "/store/product-variants?fields=id,*calculated_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "list_taxes",
    "method": "GET",
    "path": "/store/product-variants?fields=id,product.type_id,calculated_price.calculated_amount&region_id={{regions.regions.0.id}}&country_code=de",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_taxes_no_product",
    "method": "GET",
    "path": "/store/product-variants?fields=id,calculated_price.calculated_amount&region_id={{regions.regions.0.id}}&country_code=de",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_inventory",
    "method": "GET",
    "path": "/store/product-variants?fields=id,sku,inventory_quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "list_inventory_two",
    "method": "GET",
    "path": "/store/product-variants?fields=id,inventory_quantity",
    "headers": {
      "x-publishable-api-key": "{{pk2.api_key.token}}"
    }
  },
  {
    "name": "list_disallowed",
    "method": "GET",
    "path": "/store/product-variants?fields=id,prices.amount",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "retrieve",
    "method": "GET",
    "path": "/store/product-variants/{{list.variants.0.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "retrieve_full",
    "method": "GET",
    "path": "/store/product-variants/{{list.variants.0.id}}?fields=*calculated_price,inventory_quantity&region_id={{regions.regions.0.id}}&country_code=de",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "retrieve_missing",
    "method": "GET",
    "path": "/store/product-variants/variant_missing",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  }
]