[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "create_p",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products?fields=id,*options,*options.values",
    "body": {
      "title": "Option lab",
      "options": [
        {
          "title": "Size",
          "values": [
            "S",
            "M"
          ]
        }
      ]
    }
  },
  {
    "name": "link_color",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options,*options.values",
    "body": {
      "add": [
        {
          "title": "Color",
          "values": [
            "Red",
            "Blue"
          ]
        }
      ]
    }
  },
  {
    "name": "add_s",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/variants?fields=id",
    "body": {
      "title": "S Red",
      "sku": "OL-SR",
      "options": {
        "Size": "S",
        "Color": "Red"
      },
      "prices": []
    }
  },
  {
    "name": "add_m",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/variants?fields=id",
    "body": {
      "title": "M Red",
      "sku": "OL-MR",
      "options": {
        "Size": "M",
        "Color": "Red"
      },
      "prices": []
    }
  },
  {
    "name": "global_create",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/product-options",
    "body": {
      "title": "Material",
      "values": [
        "Cotton",
        "Wool",
        "Silk"
      ],
      "ranks": {
        "Wool": 1,
        "Cotton": 2
      },
      "is_exclusive": false
    }
  },
  {
    "name": "global_create_bad_rank",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/product-options",
    "body": {
      "title": "X",
      "values": [
        "a"
      ],
      "ranks": {
        "b": 1
      }
    }
  },
  {
    "name": "global_get",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}"
  },
  {
    "name": "global_get_missing",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/product-options/opt_missing"
  },
  {
    "name": "global_update",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}?fields=id,title,*values",
    "body": {
      "title": "Fabric",
      "values": [
        "Cotton",
        "Linen"
      ],
      "ranks": {
        "Linen": 0
      }
    }
  },
  {
    "name": "global_update_missing",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/product-options/opt_missing",
    "body": {
      "title": "Y"
    }
  },
  {
    "name": "product_options",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options?order=title"
  },
  {
    "name": "link_global",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options,*options.values",
    "body": {
      "add": [
        "{{global_create.product_option.id}}"
      ]
    }
  },
  {
    "name": "link_new",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options,*options.values",
    "body": {
      "add": [
        {
          "title": "Fit",
          "values": [
            "Slim",
            "Regular"
          ]
        }
      ]
    }
  },
  {
    "name": "global_exclusive",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}",
    "body": {
      "is_exclusive": true
    }
  },
  {
    "name": "global_delete_linked",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}"
  },
  {
    "name": "update_values",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options,*options.values",
    "body": {
      "update": [
        {
          "product_option_id": "{{global_create.product_option.id}}",
          "remove": [
            "{{global_update.product_option.values.0.id}}"
          ],
          "add": [
            {
              "value": "Denim"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "unlink_color_collision",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch",
    "body": {
      "remove": [
        "{{create_p.product.options.0.id}}"
      ]
    }
  },
  {
    "name": "unlink_size_ok",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options,*variants,*variants.options",
    "body": {
      "remove": [
        "{{link_color.product.options.1.id}}"
      ]
    }
  },
  {
    "name": "options_after",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/product-options?order=title&fields=id,title,is_exclusive,*values"
  },
  {
    "name": "global_delete_unlinked_fail",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}"
  },
  {
    "name": "unlink_global",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products/{{create_p.product.id}}/options/batch?fields=id,*options",
    "body": {
      "remove": [
        "{{global_create.product_option.id}}"
      ]
    }
  },
  {
    "name": "global_delete",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/product-options/{{global_create.product_option.id}}"
  },
  {
    "name": "final",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/product-options?order=title&fields=id,title,is_exclusive,*values&with_deleted=true"
  }
]
