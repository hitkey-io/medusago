[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id,variants.sku&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        }
      ]
    }
  },
  {
    "name": "set_address",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "shipping_address": {
        "first_name": "Ann",
        "address_1": "Street 1",
        "city": "Berlin",
        "country_code": "de",
        "postal_code": "10115"
      },
      "email": "buyer@example.test",
      "metadata": {
        "note": "x"
      }
    }
  },
  {
    "name": "same_address",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "shipping_address": {
        "id": "{{set_address.cart.shipping_address.id}}",
        "city": "Berlin"
      }
    }
  },
  {
    "name": "billing",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "billing_address": {
        "first_name": "Ann",
        "city": "Paris",
        "country_code": "fr"
      }
    }
  },
  {
    "name": "bad_country",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "shipping_address": {
        "country_code": "us"
      }
    }
  },
  {
    "name": "bad_email",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "email": "nope"
    }
  },
  {
    "name": "unknown_field",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "foo": "bar"
    }
  },
  {
    "name": "missing_cart",
    "method": "POST",
    "path": "/store/carts/cart_missing",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "email": "a@example.test"
    }
  },
  {
    "name": "change_region",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.1.id}}"
    }
  },
  {
    "name": "bad_region",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "reg_missing"
    }
  },
  {
    "name": "back_region",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,email,currency_code,region_id,total,tax_total,metadata,customer_id,sales_channel_id,shipping_address.*,billing_address.*,items.id,items.quantity,items.unit_price,items.tax_lines.rate",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "country_code": "fr"
      }
    }
  },
  {
    "name": "bad_promo",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "NOPE"
      ]
    }
  },
  {
    "name": "final",
    "method": "GET",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  }
]