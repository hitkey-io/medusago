[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "locations",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/stock-locations?fields=id"
  },
  {
    "name": "profiles",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/shipping-profiles?fields=id"
  },
  {
    "name": "fs",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id",
    "body": {
      "name": "EU",
      "type": "shipping"
    }
  },
  {
    "name": "zone",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id",
    "body": {
      "name": "Germany",
      "geo_zones": [
        {
          "type": "country",
          "country_code": "de"
        }
      ]
    }
  },
  {
    "name": "link_provider",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id",
    "body": {
      "add": [
        "manual_manual"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "so_std",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Standard",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Standard",
        "code": "standard",
        "description": "3-5 days"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 5
        },
        {
          "region_id": "{{regions.regions.0.id}}",
          "amount": 4.5
        }
      ],
      "rules": [
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        },
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        }
      ]
    }
  },
  {
    "name": "so_return",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Return",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Return",
        "code": "return"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 7
        }
      ],
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "true"
        }
      ]
    }
  },
  {
    "name": "so_admin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Admin only",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Express",
        "code": "express"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 15
        }
      ],
      "rules": [
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "false"
        }
      ]
    }
  },
  {
    "name": "so_norules",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Pickup",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Pickup",
        "code": "pickup"
      },
      "prices": [
        {
          "currency_code": "usd",
          "amount": 1
        }
      ]
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "country_code": "de",
        "city": "Berlin"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "add_std",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id,total,subtotal,tax_total,shipping_total,shipping_subtotal,shipping_tax_total,shipping_discount_total,discount_total,shipping_methods.id,shipping_methods.name,shipping_methods.amount,shipping_methods.shipping_option_id,shipping_methods.tax_lines.rate,shipping_methods.adjustments.code,shipping_methods.adjustments.amount,shipping_methods.data,items.id,items.quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_std.shipping_option.id}}",
      "data": {
        "note": "door"
      }
    }
  },
  {
    "name": "add_again",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id,total,subtotal,tax_total,shipping_total,shipping_subtotal,shipping_tax_total,shipping_discount_total,discount_total,shipping_methods.id,shipping_methods.name,shipping_methods.amount,shipping_methods.shipping_option_id,shipping_methods.tax_lines.rate,shipping_methods.adjustments.code,shipping_methods.adjustments.amount,shipping_methods.data,items.id,items.quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": [
      {
        "option_id": "{{so_std.shipping_option.id}}"
      }
    ]
  },
  {
    "name": "add_return",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_return.shipping_option.id}}"
    }
  },
  {
    "name": "add_admin_only",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_admin.shipping_option.id}}"
    }
  },
  {
    "name": "add_no_price",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_norules.shipping_option.id}}"
    }
  },
  {
    "name": "add_missing",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "so_missing"
    }
  },
  {
    "name": "add_bad_body",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "id": "x"
    }
  },
  {
    "name": "update_item",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{cart.cart.items.0.id}}?fields=id,total,subtotal,tax_total,shipping_total,shipping_subtotal,shipping_tax_total,shipping_discount_total,discount_total,shipping_methods.id,shipping_methods.name,shipping_methods.amount,shipping_methods.shipping_option_id,shipping_methods.tax_lines.rate,shipping_methods.adjustments.code,shipping_methods.adjustments.amount,shipping_methods.data,items.id,items.quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 2
    }
  },
  {
    "name": "ship5",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/promotions?fields=id,code",
    "body": {
      "code": "SHIP5",
      "type": "standard",
      "status": "active",
      "application_method": {
        "type": "fixed",
        "target_type": "shipping_methods",
        "allocation": "across",
        "value": 2,
        "currency_code": "eur"
      }
    }
  },
  {
    "name": "apply_ship5",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,tax_total,shipping_total,shipping_subtotal,shipping_tax_total,shipping_discount_total,discount_total,shipping_methods.id,shipping_methods.name,shipping_methods.amount,shipping_methods.shipping_option_id,shipping_methods.tax_lines.rate,shipping_methods.adjustments.code,shipping_methods.adjustments.amount,shipping_methods.data,items.id,items.quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "SHIP5"
      ]
    }
  },
  {
    "name": "change_address",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,total,subtotal,tax_total,shipping_total,shipping_subtotal,shipping_tax_total,shipping_discount_total,discount_total,shipping_methods.id,shipping_methods.name,shipping_methods.amount,shipping_methods.shipping_option_id,shipping_methods.tax_lines.rate,shipping_methods.adjustments.code,shipping_methods.adjustments.amount,shipping_methods.data,items.id,items.quantity",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "shipping_address": {
        "country_code": "fr"
      }
    }
  },
  {
    "name": "final",
    "method": "GET",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  }
]