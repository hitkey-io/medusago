[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "locations",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/stock-locations?fields=id"
  },
  {
    "name": "profiles",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/shipping-profiles?fields=id"
  },
  {
    "name": "fs",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id",
    "body": {
      "name": "EU",
      "type": "shipping"
    }
  },
  {
    "name": "zone",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id",
    "body": {
      "name": "Germany",
      "geo_zones": [
        {
          "type": "country",
          "country_code": "de"
        }
      ]
    }
  },
  {
    "name": "link_provider",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id",
    "body": {
      "add": [
        "manual_manual"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "so_std",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Standard",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Standard",
        "code": "standard",
        "description": "3-5 days"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 5
        },
        {
          "region_id": "{{regions.regions.0.id}}",
          "amount": 4.5
        }
      ],
      "rules": [
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        },
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        }
      ]
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "register",
    "method": "POST",
    "path": "/auth/customer/emailpass/register",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "customer",
    "method": "POST",
    "path": "/store/customers?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "email": "buyer@example.test",
      "first_name": "Test",
      "last_name": "Buyer"
    },
    "bearer": "register"
  },
  {
    "name": "customer_login",
    "method": "POST",
    "path": "/auth/customer/emailpass",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "first_name": "Test",
        "last_name": "Buyer",
        "address_1": "Example Street 1",
        "country_code": "de",
        "city": "Berlin",
        "postal_code": "10115"
      },
      "billing_address": {
        "country_code": "de",
        "city": "Berlin"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        }
      ],
      "metadata": {
        "source": "scenario"
      }
    },
    "bearer": "customer_login"
  },
  {
    "name": "add_shipping",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_std.shipping_option.id}}"
    },
    "bearer": "customer_login"
  },
  {
    "name": "pc",
    "method": "POST",
    "path": "/store/payment-collections?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "cart_id": "{{cart.cart.id}}"
    },
    "bearer": "customer_login"
  },
  {
    "name": "session",
    "method": "POST",
    "path": "/store/payment-collections/{{pc.payment_collection.id}}/payment-sessions?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "provider_id": "pp_system_default"
    },
    "bearer": "customer_login"
  },
  {
    "name": "complete",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/complete?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {},
    "bearer": "customer_login"
  },
  {
    "name": "fulfill1",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}/fulfillments?fields=id,status,fulfillment_status,payment_status,version,items.id,items.quantity,items.detail.fulfilled_quantity,items.detail.shipped_quantity,items.detail.delivered_quantity,fulfillments.id,fulfillments.packed_at,fulfillments.shipped_at,fulfillments.delivered_at,fulfillments.canceled_at,fulfillments.location_id,fulfillments.provider_id,fulfillments.items.quantity,fulfillments.items.title,fulfillments.items.sku,fulfillments.labels.tracking_number",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1
        }
      ],
      "metadata": {
        "batch": "first"
      }
    }
  },
  {
    "name": "export",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/orders/export"
  },
  {
    "name": "notifications",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/notifications?fields=id,to,channel,template,data,trigger_type,resource_id,resource_type,receiver_id,original_notification_id,idempotency_key,external_id,provider_id,status",
    "until": "notifications.0"
  },
  {
    "name": "file",
    "method": "GET",
    "path": "{{notifications.notifications.0.data.file.url}}"
  },
  {
    "name": "export_filtered",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/orders/export?fields=id,display_id&status[]=completed"
  },
  {
    "name": "notifications2",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/notifications?fields=id,data&order=created_at",
    "until": "notifications.1"
  },
  {
    "name": "file2",
    "method": "GET",
    "path": "{{notifications2.notifications.1.data.file.url}}"
  },
  {
    "name": "executions",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/workflows-executions?fields=id,workflow_id,transaction_id,state"
  },
  {
    "name": "execution_detail",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/workflows-executions/complete-cart/{{executions.workflow_executions.0.transaction_id}}?fields=id,workflow_id,transaction_id,state"
  },
  {
    "name": "step_success_unknown_workflow",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/workflows-executions/no-such-workflow/steps/success",
    "body": {
      "transaction_id": "t1",
      "step_id": "s1",
      "response": {
        "ok": true
      }
    }
  },
  {
    "name": "step_success_unknown_tx",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/workflows-executions/export-orders/steps/success",
    "body": {
      "transaction_id": "t1",
      "step_id": "export-orders"
    }
  },
  {
    "name": "step_failure_unknown_tx",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/workflows-executions/export-orders/steps/failure",
    "body": {
      "transaction_id": "t1",
      "step_id": "export-orders",
      "action": "INVOKE"
    }
  },
  {
    "name": "step_success_bad_action",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/workflows-executions/export-orders/steps/success",
    "body": {
      "transaction_id": "t1",
      "step_id": "export-orders",
      "action": "retry"
    }
  },
  {
    "name": "step_success_missing",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/workflows-executions/export-orders/steps/success",
    "body": {
      "step_id": "export-orders"
    }
  }
]