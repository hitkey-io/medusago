[
 {
  "name": "login",
  "method": "POST",
  "path": "/auth/user/emailpass",
  "body": {
   "email": "admin@medusa-test.com",
   "password": "supersecret"
  }
 },
 {
  "name": "pk",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys",
  "body": {
   "title": "Store",
   "type": "publishable"
  }
 },
 {
  "name": "channels",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/sales-channels?order=name&fields=id,name"
 },
 {
  "name": "link",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
  "body": {
   "add": [
    "{{channels.sales_channels.0.id}}"
   ]
  }
 },
 {
  "name": "expensive",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/products?fields=id,is_giftcard,variants.id",
  "body": {
   "title": "Expensive",
   "status": "published",
   "is_giftcard": false,
   "options": [
    {
     "title": "size",
     "values": [
      "large"
     ]
    }
   ],
   "sales_channels": [
    {
     "id": "{{channels.sales_channels.0.id}}"
    }
   ],
   "variants": [
    {
     "title": "Expensive variant",
     "manage_inventory": false,
     "options": {
      "size": "large"
     },
     "prices": [
      {
       "amount": 800,
       "currency_code": "usd"
      }
     ]
    }
   ]
  }
 },
 {
  "name": "giftcard_product",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/products?fields=id,is_giftcard,variants.id",
  "body": {
   "title": "Gift card",
   "status": "published",
   "is_giftcard": true,
   "options": [
    {
     "title": "size",
     "values": [
      "large"
     ]
    }
   ],
   "sales_channels": [
    {
     "id": "{{channels.sales_channels.0.id}}"
    }
   ],
   "variants": [
    {
     "title": "Gift card variant",
     "manage_inventory": false,
     "options": {
      "size": "large"
     },
     "prices": [
      {
       "amount": 50,
       "currency_code": "usd"
      }
     ]
    }
   ]
  }
 },
 {
  "name": "regions",
