  "name": "purchased_accounts",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/gift-cards?reference=order&fields=code,store_credit_account.balance,store_credit_account.currency_code",
  "unordered": [
   "gift_cards"
  ],
  "ignore": [
   "gift_cards.*.id",
   "gift_cards.*.store_credit_account.id"
  ]
 },
