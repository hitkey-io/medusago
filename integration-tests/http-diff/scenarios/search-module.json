  {
    "name": "create_product",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products?fields=id,title",
    "body": {
      "title": "Zebra Jacket",
      "status": "published",
      "options": [
        {
          "title": "Size",
          "values": ["One"]
        }
      ],
      "sales_channels": [
        {
          "id": "{{channels.sales_channels.0.id}}"
        }
      ],
      "variants": [
        {
          "title": "One",
          "sku": "ZEBRA-1",
          "options": {
            "Size": "One"
          },
          "prices": [
            {
              "currency_code": "usd",
              "amount": 10
            }
          ]
        }
      ]
    }
  },
