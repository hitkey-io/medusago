  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Search",
      "type": "publishable"
    }
  },
  {
    "name": "pk_empty",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "No channels",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "store_default",
    "method": "POST",
    "path": "/store/search",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "entity": "product"
    },
    "ignore": ["results.*.metadata.processing_time_ms"]
  },
  {
    "name": "store_query_facets",
    "method": "POST",
    "path": "/store/search",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "entity": "product",
      "fields": ["id", "title", "handle", "variants.sku"],
      "filters": {
        "q": "medusa"
      },
      "pagination": {
        "take": 5,
        "order": {
          "handle": "desc"
        }
      },
      "search_options": {
        "include_score": true,
        "facets": [
          "status",
          "collection_title",
          {
            "field": "tags.value",
            "limit": 5,
            "sort": "alpha"
          },
          {
            "field": "variant_count",
            "type": "range",
            "ranges": [
              {
                "to": 2
              },
              {
                "from": 2,
                "key": "many"
              }
            ]
          },
          {
            "field": "variant_count",
            "type": "stats"
          },
          {
            "field": "created_at",
            "type": "range",
            "ranges": [
              {
                "from": 0
              }
            ]
          }
        ]
      }
    },
    "ignore": ["results.*.metadata.processing_time_ms"]
  },
  {
    "name": "store_batch",
    "method": "POST",
    "path": "/store/search",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "queries": [
        {
          "entity": "product",
          "filters": {
            "q": "shrt",
            "handle": {
              "$in": ["t-shirt", "sweatpants"]
            }
          },
          "search_options": {
            "typo_tolerance": true,
            "match_strategy": "any",
            "count": "none"
          }
        },
        {
          "entity": "product",
          "fields": ["id", "handle"],
          "filters": {
            "collection_title": "Summer",
            "$or": [
              {
                "variant_count": {
                  "$gte": 2
                }
              },
              {
                "is_giftcard": true
              }
            ]
          },
          "pagination": {
            "skip": 0,
            "take": 0
          },
          "search_options": {
            "facets": ["status", "collection_title"],
            "disjunctive_facets": true
          }
        },
        {
          "entity": "product",
          "fields": ["handle"],
          "filters": {
            "handle": {
              "$prefix": "t-"
            },
            "$not": {
              "discountable": false
            }
          },
          "search_options": {
            "attributes_to_search_on": ["title"],
            "distinct": "handle",
            "min_score": 0
          }
        }
      ]
    },
    "ignore": ["results.*.metadata.processing_time_ms"]
  },
  {
    "name": "store_no_channels",
