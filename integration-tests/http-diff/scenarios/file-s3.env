# The S3 file provider against MinIO (docker run -p 12459:9000 minio/minio,
# bucket medusa-test with anonymous download), through the recording fake.
MEDUSA_TEST_FAKE_PORT=12451
MEDUSA_TEST_S3_UPSTREAM=http://localhost:12459
MEDUSA_TEST_S3_BUCKET=medusa-test
MEDUSA_TEST_MODULES=[{"key":"file","resolve":"@medusajs/medusa/file","options":{"providers":[{"resolve":"@medusajs/medusa/file-s3","id":"s3","options":{"file_url":"http://localhost:12451/medusa-test","access_key_id":"medusatest","secret_access_key":"medusatestsecret","region":"us-east-1","bucket":"medusa-test","endpoint":"http://localhost:12451","prefix":"http-diff/","additional_client_config":{"forcePathStyle":true}}}]}}]
