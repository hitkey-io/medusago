[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id,variants.sku&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "country_code": "de"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        },
        {
          "variant_id": "{{products.products.0.variants.1.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "spring",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "SPRING10"
      ]
    }
  },
  {
    "name": "invalid",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "NOPE"
      ]
    }
  },
  {
    "name": "bad_body",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "codes": [
        "X"
      ]
    }
  },
  {
    "name": "fix5",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/promotions?fields=id,code",
    "body": {
      "code": "FIX5",
      "type": "standard",
      "status": "active",
      "application_method": {
        "type": "fixed",
        "target_type": "items",
        "allocation": "across",
        "value": 5,
        "currency_code": "eur"
      }
    }
  },
  {
    "name": "apply_fix5",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "FIX5"
      ]
    }
  },
  {
    "name": "pct10",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/promotions?fields=id,code",
    "body": {
      "code": "PCT10",
      "type": "standard",
      "status": "active",
      "application_method": {
        "type": "percentage",
        "target_type": "items",
        "allocation": "each",
        "value": 10,
        "max_quantity": 1,
        "target_rules": [
          {
            "attribute": "items.product.id",
            "operator": "in",
            "values": [
              "{{products.products.1.id}}"
            ]
          }
        ]
      }
    }
  },
  {
    "name": "apply_pct10",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "PCT10"
      ]
    }
  },
  {
    "name": "remove_fix5",
    "method": "DELETE",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "FIX5"
      ]
    }
  },
  {
    "name": "replace_none",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": []
    }
  },
  {
    "name": "auto3",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/promotions?fields=id,code",
    "body": {
      "code": "AUTO3",
      "type": "standard",
      "status": "active",
      "is_automatic": true,
      "application_method": {
        "type": "percentage",
        "target_type": "order",
        "allocation": "across",
        "value": 3
      }
    }
  },
  {
    "name": "add_item",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.1.variants.0.id}}",
      "quantity": 1
    }
  },
  {
    "name": "ship10",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/promotions?fields=id,code",
    "body": {
      "code": "SHIP10",
      "type": "standard",
      "status": "active",
      "application_method": {
        "type": "fixed",
        "target_type": "shipping_methods",
        "allocation": "each",
        "value": 10,
        "currency_code": "eur"
      }
    }
  },
  {
    "name": "apply_ship",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,subtotal,discount_total,discount_subtotal,discount_tax_total,tax_total,item_total,promotions.code,items.id,items.quantity,items.unit_price,items.total,items.discount_total,items.adjustments.code,items.adjustments.amount,items.adjustments.is_tax_inclusive",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "promo_codes": [
        "SHIP10",
        "PCT10"
      ]
    }
  },
  {
    "name": "final",
    "method": "GET",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  }
]