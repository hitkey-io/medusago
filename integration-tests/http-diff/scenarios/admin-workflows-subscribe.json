   "password": "supersecret"
  }
 },
 {
  "name": "events_types",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/create-product-types/subscribe",
  "sse_until": "onFinish",
  "parallel": "g1",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ]
 },
 {
  "name": "run_types",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/workflows-executions/create-product-types/run",
  "body": {
   "transaction_id": "sse-types-1",
   "input": {
    "product_types": [
     {
      "value": "sse-type-a"
     }
    ]
   }
  },
  "parallel": "g1",
  "delay_ms": 1500
 },
 {
  "name": "events_types_dup",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/create-product-types/sse-types-2/subscribe",
  "sse_until": "onFinish",
  "parallel": "g2",
  "ignore": [
   "events.*.step.invoke",
