[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id,variants.sku&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "country_code": "de"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "add_same",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.1.variants.0.id}}",
      "quantity": 2
    }
  },
  {
    "name": "add_meta",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.1.variants.0.id}}",
      "quantity": 1,
      "metadata": {
        "engraving": "A"
      }
    }
  },
  {
    "name": "add_other",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.0.variants.1.id}}",
      "quantity": 1
    }
  },
  {
    "name": "add_bad_qty",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.0.variants.1.id}}",
      "quantity": 0
    }
  },
  {
    "name": "add_missing_variant",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "variant_missing",
      "quantity": 1
    }
  },
  {
    "name": "add_too_many",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.1.variants.0.id}}",
      "quantity": 500
    }
  },
  {
    "name": "add_missing_cart",
    "method": "POST",
    "path": "/store/carts/cart_missing/line-items",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{products.products.1.variants.0.id}}",
      "quantity": 1
    }
  },
  {
    "name": "cart_now",
    "method": "GET",
    "path": "/store/carts/{{cart.cart.id}}?fields=id,items.id,items.variant_id,items.quantity,items.metadata&order=created_at",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "update_qty",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{add_other.cart.items.0.id}}?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 3
    }
  },
  {
    "name": "update_missing",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/cali_missing",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 3
    }
  },
  {
    "name": "update_too_many",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{cart.cart.items.0.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 900
    }
  },
  {
    "name": "update_negative",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{cart.cart.items.0.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": -1
    }
  },
  {
    "name": "update_zero",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{cart.cart.items.0.id}}?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "quantity": 0
    }
  },
  {
    "name": "delete",
    "method": "DELETE",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{add_other.cart.items.0.id}}?fields=id,total,subtotal,tax_total,item_total,items.id,items.variant_id,items.quantity,items.unit_price,items.metadata,items.total,items.tax_lines.rate,items.is_custom_price",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "delete_again",
    "method": "DELETE",
    "path": "/store/carts/{{cart.cart.id}}/line-items/{{add_other.cart.items.0.id}}?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "final",
    "method": "GET",
    "path": "/store/carts/{{cart.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  }
]