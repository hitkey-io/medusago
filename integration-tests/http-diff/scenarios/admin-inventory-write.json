  { "name": "level_create", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels?fields=id,location_levels.location_id,location_levels.stocked_quantity", "body": { "location_id": "{{loc2.stock_location.id}}", "stocked_quantity": 3 } },
  { "name": "level_create_dup", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels", "body": { "location_id": "{{loc2.stock_location.id}}" } },
  { "name": "level_update", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/{{loc2.stock_location.id}}?fields=id,stocked_quantity,location_levels.stocked_quantity,location_levels.incoming_quantity", "body": { "stocked_quantity": 7, "incoming_quantity": 1 } },
  { "name": "level_update_missing", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/sloc_missing", "body": { "stocked_quantity": 1 } },
  { "name": "levels_list", "method": "GET", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels?fields=location_id,stocked_quantity,available_quantity&order=stocked_quantity" },
  { "name": "batch_delete_stocked", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/batch", "body": { "delete": ["{{levels_list.inventory_levels.0.id}}"] } },
  { "name": "batch", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/batch", "body": { "update": [{ "location_id": "{{locations.stock_locations.0.id}}", "stocked_quantity": 9 }], "delete": ["{{levels_list.inventory_levels.1.id}}"], "force": true } },
  { "name": "level_delete", "method": "DELETE", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/{{locations.stock_locations.0.id}}?fields=id,location_levels.id" },
  { "name": "level_delete_missing", "method": "DELETE", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}/location-levels/{{locations.stock_locations.0.id}}" },
  { "name": "global_batch", "method": "POST", "bearer": "login", "path": "/admin/inventory-items/location-levels/batch", "body": { "create": [{ "inventory_item_id": "{{create.inventory_item.id}}", "location_id": "{{locations.stock_locations.0.id}}", "stocked_quantity": 4 }] } },
  { "name": "delete", "method": "DELETE", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}" },
  { "name": "get_deleted", "method": "GET", "bearer": "login", "path": "/admin/inventory-items/{{create.inventory_item.id}}" },
  { "name": "list", "method": "GET", "bearer": "login", "path": "/admin/inventory-items?order=sku&fields=sku,title" }
