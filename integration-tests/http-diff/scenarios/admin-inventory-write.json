  { "name": "create_bad_location", "method": "POST", "bearer": "login", "path": "/admin/inventory-items", "body": { "sku": "INV-2", "location_levels": [{ "location_id": "sloc_missing" }] } },
  { "name": "create_negative", "method": "POST", "bearer": "login", "path": "/admin/inventory-items", "body": { "sku": "INV-3", "location_levels": [{ "location_id": "x", "stocked_quantity": -1 }] } },
  { "name": "create_dup_sku", "method": "POST", "bearer": "login", "path": "/admin/inventory-items", "body": { "sku": "INV-1" } },
