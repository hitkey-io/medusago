[
  { "name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": { "email": "admin@medusa-test.com", "password": "supersecret" } },
  { "name": "list", "method": "GET", "bearer": "login", "path": "/admin/stores" },
  { "name": "regions", "method": "GET", "bearer": "login", "path": "/admin/regions?order=name&fields=id" },
  { "name": "get", "method": "GET", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}" },
  { "name": "get_missing", "method": "GET", "bearer": "login", "path": "/admin/stores/store_missing" },
  { "name": "update_name", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "name": "  Renamed store  ", "default_region_id": "{{regions.regions.0.id}}", "metadata": { "a": 1 } } },
  { "name": "update_currencies", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "supported_currencies": [{ "currency_code": "USD", "is_default": true, "is_tax_inclusive": true }, { "currency_code": "eur" }, { "currency_code": "gbp", "is_tax_inclusive": false }] } },
  { "name": "prefs", "method": "GET", "bearer": "login", "path": "/admin/price-preferences?attribute=currency_code&order=value&fields=value,is_tax_inclusive" },
  { "name": "update_two_defaults", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "supported_currencies": [{ "currency_code": "usd", "is_default": true }, { "currency_code": "eur", "is_default": true }] } },
  { "name": "update_no_default", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "supported_currencies": [{ "currency_code": "usd" }] } },
  { "name": "update_dup", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "supported_currencies": [{ "currency_code": "usd", "is_default": true }, { "currency_code": "USD" }] } },
  { "name": "update_unknown_currency", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "supported_currencies": [{ "currency_code": "zzz", "is_default": true }] } },
  { "name": "update_invalid", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}", "body": { "name": 1 } },
  { "name": "update_empty", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}?fields=id,name,metadata", "body": {} },
  { "name": "update_clear", "method": "POST", "bearer": "login", "path": "/admin/stores/{{list.stores.0.id}}?fields=id,default_region_id,metadata,*supported_currencies", "body": { "default_region_id": null, "metadata": null } },
  { "name": "update_missing", "method": "POST", "bearer": "login", "path": "/admin/stores/store_missing", "body": { "name": "x" } },
  { "name": "list_after", "method": "GET", "bearer": "login", "path": "/admin/stores?fields=name,*supported_currencies" }
]
