   "password": "secret"
  }
 },
 {
  "name": "cart",
  "method": "POST",
  "path": "/store/carts?fields=id,items.id",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
   "region_id": "{{regions.regions.0.id}}",
   "shipping_address": {
    "first_name": "Test",
    "last_name": "Buyer",
    "address_1": "Example Street 1",
    "country_code": "de",
    "city": "Berlin",
    "postal_code": "10115"
   },
   "billing_address": {
    "country_code": "de",
    "city": "Berlin"
   },
   "items": [
    {
     "variant_id": "{{products.products.1.variants.0.id}}",
     "quantity": 2
    }
   ],
   "metadata": {
    "source": "scenario"
   }
  },
  "bearer": "customer_login"
 },
 {
  "name": "add_shipping",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
