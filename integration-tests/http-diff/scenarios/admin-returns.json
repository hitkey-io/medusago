[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "locations",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/stock-locations?fields=id"
  },
  {
    "name": "profiles",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/shipping-profiles?fields=id"
  },
  {
    "name": "fs",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id",
    "body": {
      "name": "EU",
      "type": "shipping"
    }
  },
  {
    "name": "zone",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id",
    "body": {
      "name": "Germany",
      "geo_zones": [
        {
          "type": "country",
          "country_code": "de"
        }
      ]
    }
  },
  {
    "name": "link_provider",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id",
    "body": {
      "add": [
        "manual_manual"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "so_std",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Standard",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Standard",
        "code": "standard",
        "description": "3-5 days"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 5
        },
        {
          "region_id": "{{regions.regions.0.id}}",
          "amount": 4.5
        }
      ],
      "rules": [
        {
          "attribute": "enabled_in_store",
          "operator": "eq",
          "value": "true"
        },
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "false"
        }
      ]
    }
  },
  {
    "name": "so_return",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/shipping-options?fields=id",
    "body": {
      "name": "Return",
      "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "price_type": "flat",
      "provider_id": "manual_manual",
      "type": {
        "label": "Return",
        "code": "return"
      },
      "prices": [
        {
          "currency_code": "eur",
          "amount": 7
        }
      ],
      "rules": [
        {
          "attribute": "is_return",
          "operator": "eq",
          "value": "true"
        }
      ]
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "register",
    "method": "POST",
    "path": "/auth/customer/emailpass/register",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "customer",
    "method": "POST",
    "path": "/store/customers?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "email": "buyer@example.test",
      "first_name": "Test",
      "last_name": "Buyer"
    },
    "bearer": "register"
  },
  {
    "name": "customer_login",
    "method": "POST",
    "path": "/auth/customer/emailpass",
    "body": {
      "email": "buyer@example.test",
      "password": "secret"
    }
  },
  {
    "name": "cart",
    "method": "POST",
    "path": "/store/carts?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "shipping_address": {
        "first_name": "Test",
        "last_name": "Buyer",
        "address_1": "Example Street 1",
        "country_code": "de",
        "city": "Berlin",
        "postal_code": "10115"
      },
      "billing_address": {
        "country_code": "de",
        "city": "Berlin"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        }
      ],
      "metadata": {
        "source": "scenario"
      }
    },
    "bearer": "customer_login"
  },
  {
    "name": "add_shipping",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/shipping-methods?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "option_id": "{{so_std.shipping_option.id}}"
    },
    "bearer": "customer_login"
  },
  {
    "name": "pc",
    "method": "POST",
    "path": "/store/payment-collections?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "cart_id": "{{cart.cart.id}}"
    },
    "bearer": "customer_login"
  },
  {
    "name": "session",
    "method": "POST",
    "path": "/store/payment-collections/{{pc.payment_collection.id}}/payment-sessions?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "provider_id": "pp_system_default"
    },
    "bearer": "customer_login"
  },
  {
    "name": "complete",
    "method": "POST",
    "path": "/store/carts/{{cart.cart.id}}/complete?fields=id,items.id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {},
    "bearer": "customer_login"
  },
  {
    "name": "fulfill",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}/fulfillments?fields=id",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 2
        }
      ]
    }
  },
  {
    "name": "reason",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/return-reasons?fields=id,value",
    "body": {
      "value": "damaged",
      "label": "Damaged"
    }
  },
  {
    "name": "begin_bad",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns",
    "body": {
      "order_id": "order_missing"
    }
  },
  {
    "name": "begin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns",
    "body": {
      "order_id": "{{complete.order.id}}",
      "description": "first",
      "location_id": "{{locations.stock_locations.0.id}}"
    }
  },
  {
    "name": "begin_again",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns",
    "body": {
      "order_id": "{{complete.order.id}}"
    }
  },
  {
    "name": "request_too_many",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/request-items",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 5
        }
      ]
    }
  },
  {
    "name": "request_items",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/request-items",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1,
          "reason_id": "{{reason.return_reason.id}}",
          "internal_note": "scratched"
        }
      ]
    }
  },
  {
    "name": "shipping",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/shipping-method",
    "body": {
      "shipping_option_id": "{{so_return.shipping_option.id}}",
      "custom_amount": 3
    }
  },
  {
    "name": "confirm",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/request"
  },
  {
    "name": "returns",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/returns?fields=id,status,order_id,location_id,refund_amount,items.quantity,items.received_quantity,items.item_id,shipping_methods.name,shipping_methods.amount"
  },
  {
    "name": "return",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}"
  },
  {
    "name": "receive_begin",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/receive",
    "body": {
      "description": "arrived"
    }
  },
  {
    "name": "receive_items",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/receive-items",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "receive_confirm",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin.return.id}}/receive/confirm"
  },
  {
    "name": "order_after",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}?fields=id,version,summary,items.detail.return_requested_quantity,items.detail.return_received_quantity,items.detail.fulfilled_quantity,returns.id,returns.status"
  },
  {
    "name": "begin2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns?fields=id,status,order_id,location_id,refund_amount,items.quantity,items.received_quantity,items.item_id,shipping_methods.name,shipping_methods.amount",
    "body": {
      "order_id": "{{complete.order.id}}"
    }
  },
  {
    "name": "request2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/returns/{{begin2.return.id}}/request-items?fields=id,status,order_id,location_id,refund_amount,items.quantity,items.received_quantity,items.item_id,shipping_methods.name,shipping_methods.amount",
    "body": {
      "items": [
        {
          "id": "{{complete.order.items.0.id}}",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "cancel_request2",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/returns/{{begin2.return.id}}/request"
  },
  {
    "name": "changes",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}/changes?fields=id,change_type,status,version,return_id,actions.action,actions.amount,actions.details"
  },
  {
    "name": "order_final",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/orders/{{complete.order.id}}"
  }
]