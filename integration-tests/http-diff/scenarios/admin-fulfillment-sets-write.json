  { "name": "location_sets", "method": "GET", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}?fields=id,*fulfillment_sets" },
  { "name": "zone_create", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones", "body": { "name": "Western Europe", "geo_zones": [{ "type": "country", "country_code": "de" }, { "type": "province", "country_code": "fr", "province_code": "fr-idf" }] } },
  { "name": "zone_create_bad_geo", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones", "body": { "name": "Bad", "geo_zones": [{ "type": "city", "country_code": "de" }] } },
  { "name": "zone_create_dup", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones", "body": { "name": "Western Europe" } },
  { "name": "zone_get", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}" },
  { "name": "zone_get_missing", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/serzo_missing" },
  { "name": "zone_update", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}?fields=id,service_zones.name,service_zones.geo_zones.type,service_zones.geo_zones.country_code", "body": { "name": "Central Europe", "geo_zones": [{ "id": "{{zone_create.fulfillment_set.service_zones.0.geo_zones.0.id}}", "type": "country", "country_code": "at" }, { "type": "country", "country_code": "ch" }] } },
  { "name": "zone_update_missing_geo", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}", "body": { "geo_zones": [{ "id": "fgz_missing", "type": "country", "country_code": "it" }] } },
  { "name": "zone_update_wrong_set", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/fuset_missing/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}", "body": { "name": "x" } },
  { "name": "zone_delete", "method": "DELETE", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}" },
  { "name": "zone_get_deleted", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}/service-zones/{{zone_create.fulfillment_set.service_zones.0.id}}" },
  { "name": "fs_delete", "method": "DELETE", "bearer": "login", "path": "/admin/fulfillment-sets/{{location_sets.stock_location.fulfillment_sets.0.id}}" },
  { "name": "location_sets_after", "method": "GET", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}?fields=id,*fulfillment_sets" },
  { "name": "profile_delete", "method": "DELETE", "bearer": "login", "path": "/admin/shipping-profiles/{{profile_create.shipping_profile.id}}" },
  { "name": "profile_delete_missing", "method": "DELETE", "bearer": "login", "path": "/admin/shipping-profiles/sp_missing" },
  { "name": "profile_delete_linked", "method": "DELETE", "bearer": "login", "path": "/admin/shipping-profiles/{{profiles.shipping_profiles.0.id}}" },
  { "name": "profiles_after", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles?order=name&fields=name,type" }
