  { "name": "profile_get", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles/{{profile_create.shipping_profile.id}}" },
  { "name": "profile_get_missing", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles/sp_missing" },
