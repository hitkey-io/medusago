[
 {
  "name": "login",
  "method": "POST",
  "path": "/auth/user/emailpass",
  "body": {
   "email": "admin@medusa-test.com",
   "password": "supersecret"
  }
 },
 {
  "name": "up_a",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/uploads",
  "files": [
   {
    "field": "files",
    "name": "detail_a.csv",
    "type": "text/csv",
    "content": "Product Handle,Product Title,Product Status,Variant Title,Variant Sku,Variant Price EUR,Variant Option 1 Name,Variant Option 1 Value\ndetail-mug,Detail Mug,published,Standard,DETAIL-MUG-1,9,Size,Standard\n"
   }
  ]
 },
 {
  "name": "import_a",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/products/imports",
  "body": {
   "file_key": "{{up_a.files.0.id}}",
   "originalname": "detail_a.csv",
   "extension": "csv",
   "size": 100,
   "mime_type": "text/csv"
  }
 },
 {
  "name": "executions",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions?workflow_id=import-products-as-chunks&fields=id,state"
 },
 {
  "name": "journal_waiting",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/{{executions.workflow_executions.0.id}}",
  "ignore": [
   "workflow_execution.execution.metadata.sourcePath",
   "workflow_execution.context.errors.*.error.stack"
  ]
 },
 {
  "name": "list_full",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions?workflow_id=import-products-as-chunks",
  "ignore": [
   "workflow_executions.*.execution.metadata.sourcePath"
  ]
 },
 {
  "name": "confirm",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/products/imports/{{import_a.transaction_id}}/confirm"
 },
 {
  "name": "journal_after",
  "method": "GET",
  "bearer": "login",
  "until_absent": "workflow_execution",
  "path": "/admin/workflows-executions/{{executions.workflow_executions.0.id}}",
  "ignore": [
   "workflow_execution.execution.metadata.sourcePath",
   "workflow_execution.context.errors.*.error.stack"
  ]
 },
 {
  "name": "products",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/products?fields=handle,title&order=handle"
 }
]