[
  {"name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": {"email": "admin@medusa-test.com", "password": "supersecret"}},
  {"name": "pk", "method": "POST", "bearer": "login", "path": "/admin/api-keys", "body": {"title": "Store", "type": "publishable"}},
  {"name": "channels", "method": "GET", "bearer": "login", "path": "/admin/sales-channels?order=name&fields=id,name"},
  {"name": "link", "method": "POST", "bearer": "login", "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id", "body": {"add": ["{{channels.sales_channels.0.id}}"]}},
  {"name": "refresh_actor", "method": "POST", "path": "/auth/token/refresh", "bearer": "login"},
  {"name": "me_refreshed", "method": "GET", "path": "/admin/users/me?fields=id,email", "bearer": "refresh_actor"},
  {"name": "refresh_unauth", "method": "POST", "path": "/auth/token/refresh"},
  {"name": "register", "method": "POST", "path": "/auth/customer/emailpass/register", "body": {"email": "refresh@example.test", "password": "secret"}},
  {"name": "refresh_no_actor", "method": "POST", "path": "/auth/token/refresh", "bearer": "register"},
  {"name": "customer_create", "method": "POST", "path": "/store/customers?fields=id,email", "bearer": "refresh_no_actor", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"email": "refresh@example.test"}},
  {"name": "enroll", "method": "POST", "bearer": "login", "path": "/auth/mfa/factors", "body": {"provider": "totp", "label": "Admin device", "metadata": {"device": "phone"}}},
  {"name": "verify", "method": "POST", "bearer": "login", "path": "/auth/mfa/factors/{{enroll.mfa_factor.id}}/verify", "body": {"code": "__TOTP__"}, "totp": "enroll.secret"},
  {"name": "login_mfa", "method": "POST", "path": "/auth/user/emailpass", "body": {"email": "admin@medusa-test.com", "password": "supersecret"}},
  {"name": "refresh_mfa_challenge", "method": "POST", "path": "/auth/token/refresh", "bearer": "login_mfa"},
  {"name": "me_after_refresh", "method": "GET", "path": "/admin/users/me?fields=id", "bearer": "refresh_mfa_challenge"}
]
