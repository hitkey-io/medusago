[
  { "name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": { "email": "admin@medusa-test.com", "password": "supersecret" } },
  { "name": "locations", "method": "GET", "bearer": "login", "path": "/admin/stock-locations?fields=id" },
  { "name": "profiles", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles?fields=id" },
  { "name": "fs_create", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id", "body": { "name": "EU", "type": "shipping" } },
  { "name": "zone_create", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{fs_create.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id", "body": { "name": "Germany", "geo_zones": [{ "type": "country", "country_code": "de" }] } },
  { "name": "link_provider", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id", "body": { "add": ["manual_manual"] } },
  { "name": "so_create", "method": "POST", "bearer": "login", "path": "/admin/shipping-options?fields=id,rules.id,rules.attribute", "body": { "name": "Standard", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type": { "label": "Standard", "code": "standard" }, "prices": [{ "currency_code": "eur", "amount": 10 }], "rules": [{ "attribute": "enabled_in_store", "operator": "eq", "value": "true" }] } },
  { "name": "batch_create_only", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}/rules/batch", "body": { "create": [{ "attribute": "is_return", "operator": "eq", "value": "false" }] } },
  { "name": "rules_after_create", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}?fields=id,rules.attribute,rules.value,rules.operator" },
  { "name": "batch_update", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}/rules/batch", "body": { "update": [{ "id": "{{so_create.shipping_option.rules.0.id}}", "attribute": "enabled_in_store", "operator": "eq", "value": "false" }] } },
  { "name": "batch_all", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}/rules/batch?fields=id,attribute,value", "body": { "create": [{ "attribute": "item_total", "operator": "gt", "value": "100" }], "update": [{ "id": "{{so_create.shipping_option.rules.0.id}}", "attribute": "enabled_in_store", "operator": "eq", "value": "true" }], "delete": ["{{so_create.shipping_option.rules.0.id}}"] } },
  { "name": "batch_invalid_operator", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}/rules/batch", "body": { "create": [{ "attribute": "x", "operator": "like", "value": "1" }], "update": [] } },
  { "name": "batch_in_not_array", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}/rules/batch", "body": { "create": [{ "attribute": "x", "operator": "in", "value": "1" }], "update": [{ "id": "{{so_create.shipping_option.rules.0.id}}", "attribute": "a", "operator": "eq", "value": "b" }] } },
  { "name": "rules_final", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}?fields=id,rules.attribute,rules.value,rules.operator" }
]
