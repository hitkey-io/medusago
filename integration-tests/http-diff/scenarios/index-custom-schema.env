MEDUSA_FF_INDEX_ENGINE=true
# the index module `schema` option (testapp/index-schemas/custom-a.graphql);
# the restart step switches to custom-b.graphql
MEDUSA_TEST_INDEX_SCHEMA=custom-a.graphql
# upstream db:migrate with the flag and the custom schema on a copy of medusa_ref
# (integration-tests/http-diff/testapp/medusa-config.js)
TEMPLATE_DB=ix_ref_index_custom
