# The GitHub and Google auth providers against the fake OAuth services.
MEDUSA_TEST_FAKE_PORT=12451
MEDUSA_TEST_FAKE_HOSTS=github.com=/github,api.github.com=/github-api,oauth2.googleapis.com=/google-oauth,www.googleapis.com=/googleapis
MEDUSA_TEST_MODULES=[{"key":"auth","resolve":"@medusajs/medusa/auth","options":{"providers":[{"resolve":"@medusajs/medusa/auth-emailpass","id":"emailpass"},{"resolve":"@medusajs/medusa/auth-github","id":"github","options":{"clientId":"gh-client","clientSecret":"gh-secret","callbackUrl":"http://localhost:8000/auth/github/callback"}},{"resolve":"@medusajs/medusa/auth-google","id":"google","options":{"clientId":"google-client.apps.example.test","clientSecret":"google-secret","callbackUrl":"http://localhost:8000/auth/google/callback"}}]}}]
