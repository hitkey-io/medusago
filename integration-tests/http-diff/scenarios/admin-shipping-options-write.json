[
  { "name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": { "email": "admin@medusa-test.com", "password": "supersecret" } },
  { "name": "locations", "method": "GET", "bearer": "login", "path": "/admin/stock-locations?fields=id" },
  { "name": "regions", "method": "GET", "bearer": "login", "path": "/admin/regions?order=name&fields=id,currency_code" },
  { "name": "profiles", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles?fields=id" },
  { "name": "providers", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-providers" },
  { "name": "provider_options", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-providers/manual_manual/options" },
  { "name": "provider_options_missing", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-providers/nope_nope/options" },
  { "name": "fs_create", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id", "body": { "name": "EU", "type": "shipping" } },
  { "name": "zone_create", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{fs_create.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id", "body": { "name": "Germany", "geo_zones": [{ "type": "country", "country_code": "de" }] } },
  { "name": "so_create_no_provider", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "Std", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type": { "label": "Standard", "code": "standard" }, "prices": [{ "currency_code": "eur", "amount": 10 }] } },
  { "name": "link_provider", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id", "body": { "add": ["manual_manual"] } },
  { "name": "providers_by_location", "method": "GET", "bearer": "login", "path": "/admin/fulfillment-providers?stock_location_id={{locations.stock_locations.0.id}}" },
  { "name": "so_create", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "Standard", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "data": { "id": "manual-fulfillment" }, "type": { "label": "Standard", "description": "3-5 days", "code": "standard" }, "prices": [{ "currency_code": "eur", "amount": 10 }, { "region_id": "{{regions.regions.1.id}}", "amount": 12 }], "rules": [{ "attribute": "enabled_in_store", "operator": "eq", "value": "true" }, { "attribute": "is_return", "operator": "eq", "value": "false" }] } },
  { "name": "so_create_both_types", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "X", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type_id": "sotype_x", "type": { "label": "a", "code": "a" }, "prices": [] } },
  { "name": "so_create_bad_region", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "X", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type_id": "{{so_create.shipping_option.type.id}}", "prices": [{ "region_id": "reg_missing", "amount": 1 }] } },
  { "name": "so_create_calculated", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "Calc", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "calculated", "provider_id": "manual_manual", "type_id": "{{so_create.shipping_option.type.id}}", "prices": [] } },
  { "name": "so_create_bad_rule", "method": "POST", "bearer": "login", "path": "/admin/shipping-options", "body": { "name": "R", "service_zone_id": "{{zone_create.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type_id": "{{so_create.shipping_option.type.id}}", "prices": [], "rules": [{ "attribute": "x", "operator": "in", "value": "a" }] } },
  { "name": "so_get", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}?fields=id,name,*prices,prices.price_rules.attribute,prices.price_rules.value,*rules,*type" },
  { "name": "so_get_missing", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/so_missing" },
  { "name": "so_list_location", "method": "GET", "bearer": "login", "path": "/admin/shipping-options?stock_location_id={{locations.stock_locations.0.id}}&fields=id,name,price_type" },
  { "name": "so_update", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}?fields=id,name,prices.amount,prices.currency_code,rules.attribute,rules.value", "body": { "name": "Standard 2", "prices": [{ "id": "{{so_get.shipping_option.prices.0.id}}", "amount": 15 }, { "currency_code": "usd", "amount": 20 }], "rules": [{ "id": "{{so_get.shipping_option.rules.0.id}}", "attribute": "enabled_in_store", "operator": "eq", "value": "false" }] } },
  { "name": "so_update_type", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}?fields=id,type.code", "body": { "type_id": "{{so_create.shipping_option.type.id}}" } },
  { "name": "so_update_missing", "method": "POST", "bearer": "login", "path": "/admin/shipping-options/so_missing", "body": { "name": "x" } },
  { "name": "so_delete", "method": "DELETE", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}" },
  { "name": "so_get_deleted", "method": "GET", "bearer": "login", "path": "/admin/shipping-options/{{so_create.shipping_option.id}}" },
  { "name": "so_list", "method": "GET", "bearer": "login", "path": "/admin/shipping-options?fields=id,name" }
]
