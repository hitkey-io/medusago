  { "name": "grand", "method": "POST", "bearer": "login", "path": "/admin/product-categories?fields=id,name,rank,mpath,parent_category_id", "body": { "name": "Dome tents", "parent_category_id": "{{child.product_category.id}}" } },
  { "name": "great", "method": "POST", "bearer": "login", "path": "/admin/product-categories?fields=id,name,rank,mpath,parent_category_id", "body": { "name": "Two person", "parent_category_id": "{{grand.product_category.id}}" } },
