[
 {
  "name": "login",
  "method": "POST",
  "path": "/auth/user/emailpass",
  "body": {
   "email": "admin@medusa-test.com",
   "password": "supersecret"
  }
 },
 {
  "name": "pk",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys",
  "body": {
   "title": "Store",
   "type": "publishable"
  }
 },
 {
  "name": "channels",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/sales-channels?order=name&fields=id,name"
 },
 {
  "name": "link",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
  "body": {
   "add": [
    "{{channels.sales_channels.0.id}}"
   ]
  }
 },
 {
  "name": "locations",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/stock-locations?fields=id"
 },
 {
  "name": "profiles",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/shipping-profiles?fields=id"
 },
 {
  "name": "fs",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id",
  "body": {
   "name": "EU",
   "type": "shipping"
  }
 },
 {
  "name": "zone",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id",
  "body": {
   "name": "Germany",
   "geo_zones": [
    {
     "type": "country",
     "country_code": "de"
    }
   ]
  }
 },
 {
  "name": "link_provider",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id",
  "body": {
   "add": [
    "manual_manual"
   ]
  }
 },
 {
  "name": "regions",
  "method": "GET",
  "path": "/store/regions?order=name&fields=id,name",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  }
 },
 {
  "name": "so_std",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/shipping-options?fields=id",
  "body": {
   "name": "Standard",
   "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}",
   "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
   "price_type": "flat",
   "provider_id": "manual_manual",
   "type": {
    "label": "Standard",
    "code": "standard",
    "description": "3-5 days"
   },
   "prices": [
    {
     "currency_code": "eur",
     "amount": 5
    },
    {
     "region_id": "{{regions.regions.0.id}}",
     "amount": 4.5
    }
   ],
   "rules": [
    {
     "attribute": "enabled_in_store",
     "operator": "eq",
     "value": "true"
    },
    {
     "attribute": "is_return",
     "operator": "eq",
     "value": "false"
    }
   ]
  }
 },
 {
  "name": "products",
  "method": "GET",
  "path": "/store/products?fields=id,title,variants.id&order=title",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  }
 },
 {
  "name": "tax_region",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/tax-regions?country_code=de&fields=id"
 },
 {
  "name": "rate_default",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/tax-rates?fields=id",
  "body": {
   "tax_region_id": "{{tax_region.tax_regions.0.id}}",
   "name": "DE VAT",
   "code": "DE19",
   "rate": 19,
   "is_default": true
  }
 },
 {
  "name": "register",
  "method": "POST",
  "path": "/auth/customer/emailpass/register",
  "body": {
   "email": "buyer@example.test",
   "password": "secret"
  }
 },
 {
  "name": "customer",
  "method": "POST",
  "path": "/store/customers?fields=id",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
   "email": "buyer@example.test",
   "first_name": "Test",
   "last_name": "Buyer"
  },
  "bearer": "register"
 },
 {
  "name": "customer_login",
  "method": "POST",
  "path": "/auth/customer/emailpass",
  "body": {
   "email": "buyer@example.test",
   "password": "secret"
  }
 },
 {
  "name": "tr_product",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/translations/batch?fields=id",
  "body": {
   "create": [
    {
     "reference_id": "{{products.products.1.id}}",
     "reference": "product",
     "locale_code": "fr-FR",
     "translations": {
      "title": "Pantalon de survetement",
      "subtitle": "Doux",
      "description": "Un pantalon"
     }
    }
   ]
  }
 },
 {
  "name": "tr_variant",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/translations/batch?fields=id",
  "body": {
   "create": [
    {
     "reference_id": "{{products.products.1.variants.0.id}}",
     "reference": "product_variant",
     "locale_code": "fr-FR",
     "translations": {
      "title": "Moyen"
     }
    }
   ]
  }
 },
 {
  "name": "tr_shipping",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/translations/batch?fields=id",
  "body": {
   "create": [
    {
     "reference_id": "{{so_std.shipping_option.id}}",
     "reference": "shipping_option",
     "locale_code": "fr-FR",
     "translations": {
      "name": "Livraison standard"
     }
    }
   ]
  }
 },
 {
  "name": "tr_tax_rate",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/translations/batch?fields=id",
  "body": {
   "create": [
    {
     "reference_id": "{{rate_default.tax_rate.id}}",
     "reference": "tax_rate",
     "locale_code": "fr-FR",
     "translations": {
      "name": "TVA DE"
     }
    }
   ]
  }
 },
 {
  "name": "tr_product_de",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/translations/batch?fields=id",
  "body": {
   "create": [
    {
     "reference_id": "{{products.products.1.id}}",
     "reference": "product",
     "locale_code": "de-DE",
     "translations": {
      "title": "Jogginghose"
     }
    }
   ]
  }
 },
 {
  "name": "cart",
  "method": "POST",
  "path": "/store/carts?fields=id,items.id",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
   "region_id": "{{regions.regions.0.id}}",
   "shipping_address": {
    "first_name": "Test",
