[
  {"name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": {"email": "admin@medusa-test.com", "password": "supersecret"}},
  {"name": "pk", "method": "POST", "bearer": "login", "path": "/admin/api-keys", "body": {"title": "Store", "type": "publishable"}},
  {"name": "channels", "method": "GET", "bearer": "login", "path": "/admin/sales-channels?order=name&fields=id,name"},
  {"name": "link", "method": "POST", "bearer": "login", "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id", "body": {"add": ["{{channels.sales_channels.0.id}}"]}},
  {"name": "locations", "method": "GET", "bearer": "login", "path": "/admin/stock-locations?fields=id"},
  {"name": "profiles", "method": "GET", "bearer": "login", "path": "/admin/shipping-profiles?fields=id"},
  {"name": "fs", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-sets?fields=id,fulfillment_sets.id", "body": {"name": "EU", "type": "shipping"}},
  {"name": "zone", "method": "POST", "bearer": "login", "path": "/admin/fulfillment-sets/{{fs.stock_location.fulfillment_sets.0.id}}/service-zones?fields=id,service_zones.id", "body": {"name": "Germany", "geo_zones": [{"type": "country", "country_code": "de"}]}},
  {"name": "link_provider", "method": "POST", "bearer": "login", "path": "/admin/stock-locations/{{locations.stock_locations.0.id}}/fulfillment-providers?fields=id", "body": {"add": ["manual_manual"]}},
  {"name": "regions", "method": "GET", "path": "/store/regions?order=name&fields=id,name", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "so_std", "method": "POST", "bearer": "login", "path": "/admin/shipping-options?fields=id", "body": {"name": "Standard", "service_zone_id": "{{zone.fulfillment_set.service_zones.0.id}}", "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}", "price_type": "flat", "provider_id": "manual_manual", "type": {"label": "Standard", "code": "standard", "description": "3-5 days"}, "prices": [{"currency_code": "eur", "amount": 5}], "rules": [{"attribute": "enabled_in_store", "operator": "eq", "value": "true"}, {"attribute": "is_return", "operator": "eq", "value": "false"}]}},
  {"name": "providers", "method": "GET", "bearer": "login", "path": "/admin/payments/payment-providers?order=id&limit=20"},
  {"name": "region_providers", "method": "POST", "bearer": "login", "path": "/admin/regions/{{regions.regions.0.id}}?fields=id,payment_providers.id", "body": {"payment_providers": ["pp_system_default", "pp_stripe_stripe", "pp_stripe-ideal_stripe"]}},
  {"name": "products", "method": "GET", "path": "/store/products?fields=id,title,variants.id&order=title", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}},
  {"name": "register", "method": "POST", "path": "/auth/customer/emailpass/register", "body": {"email": "buyer1@example.test", "password": "secret"}},
  {"name": "customer", "method": "POST", "path": "/store/customers?fields=id", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"email": "buyer1@example.test", "first_name": "Test", "last_name": "Buyer"}, "bearer": "register"},
  {"name": "customer_login", "method": "POST", "path": "/auth/customer/emailpass", "body": {"email": "buyer1@example.test", "password": "secret"}},
  {"name": "address", "method": "POST", "path": "/store/customers/me/addresses?fields=id", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"first_name": "Test", "last_name": "Buyer", "address_1": "Example Street 1", "country_code": "de", "city": "Berlin", "postal_code": "10115", "is_default_billing": true}, "bearer": "customer_login"},
  {"name": "cart1", "method": "POST", "path": "/store/carts?fields=id,total", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"region_id": "{{regions.regions.0.id}}", "email": "buyer1@example.test", "shipping_address": {"first_name": "Test", "last_name": "Buyer", "address_1": "Example Street 1", "country_code": "de", "city": "Berlin", "postal_code": "10115"}, "billing_address": {"country_code": "de", "city": "Berlin"}, "items": [{"variant_id": "{{products.products.1.variants.0.id}}", "quantity": 2}]}, "bearer": "customer_login"},
  {"name": "ship1", "method": "POST", "path": "/store/carts/{{cart1.cart.id}}/shipping-methods?fields=id,total", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"option_id": "{{so_std.shipping_option.id}}"}, "bearer": "customer_login"},
  {"name": "pc1", "method": "POST", "path": "/store/payment-collections?fields=id,amount", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"cart_id": "{{cart1.cart.id}}"}, "bearer": "customer_login"},
  {"name": "session_fail", "method": "POST", "path": "/store/payment-collections/{{pc1.payment_collection.id}}/payment-sessions?fields=id,amount,status,payment_sessions.id,payment_sessions.provider_id,payment_sessions.status,payment_sessions.amount,payment_sessions.data", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"provider_id": "pp_stripe_stripe", "data": {"payment_description": "fake_failure"}}, "bearer": "customer_login"},
  {"name": "requests_fail", "method": "GET", "path": "/__requests", "service": "stripe"},
  {"name": "session_ok", "method": "POST", "path": "/store/payment-collections/{{pc1.payment_collection.id}}/payment-sessions?fields=id,amount,status,payment_sessions.id,payment_sessions.provider_id,payment_sessions.status,payment_sessions.amount,payment_sessions.data", "headers": {"x-publishable-api-key": "{{pk.api_key.token}}"}, "body": {"provider_id": "pp_stripe_stripe", "data": {"payment_description": "Scenario order"}}, "bearer": "customer_login"},
  {"name": "requests_ok", "method": "GET", "path": "/__requests", "service": "stripe"}
]
