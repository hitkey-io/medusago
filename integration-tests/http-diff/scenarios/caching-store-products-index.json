      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "Apparel",
      "code": "APP7",
      "rate": 7,
      "rules": [
        {
          "reference": "product_type",
          "reference_id": "{{types.product_types.0.id}}"
        }
      ]
    }
  },
