[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "pk2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Two channels",
      "type": "publishable"
    }
  },
  {
    "name": "pk3",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "No channels",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "link2",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk2.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}",
        "{{channels.sales_channels.1.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
