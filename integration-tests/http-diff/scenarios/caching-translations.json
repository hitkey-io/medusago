[
  { "name": "login", "method": "POST", "path": "/auth/user/emailpass", "body": { "email": "admin@medusa-test.com", "password": "supersecret" } },
  { "name": "pk", "method": "POST", "path": "/admin/api-keys", "bearer": "login", "body": { "title": "Cached locale store", "type": "publishable" } },
  { "name": "channels", "method": "GET", "path": "/admin/sales-channels?order=name&fields=id,name", "bearer": "login" },
  { "name": "link", "method": "POST", "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id", "bearer": "login", "body": { "add": ["{{channels.sales_channels.0.id}}"] } },
  { "name": "stores", "method": "GET", "path": "/admin/stores?fields=id", "bearer": "login" },
  { "name": "store_locales", "method": "POST", "path": "/admin/stores/{{stores.stores.0.id}}?fields=id,supported_locales.locale_code", "bearer": "login", "body": { "supported_locales": [{ "locale_code": "fr-FR" }] } },
  { "name": "regions", "method": "GET", "path": "/store/regions?order=name&fields=id,name,currency_code", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "products", "method": "GET", "path": "/admin/products?status[]=published&order=title&limit=1&fields=id,title,variants.id,variants.title", "bearer": "login" },
  { "name": "create_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "create": [{ "reference_id": "{{products.products.0.id}}", "reference": "product", "locale_code": "fr-FR", "translations": { "title": "Titre A" } }] } },
  { "name": "create_variant_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "create": [{ "reference_id": "{{products.products.0.variants.0.id}}", "reference": "product_variant", "locale_code": "fr-FR", "translations": { "title": "Variante A" } }] } },
  { "name": "store_fr_1", "method": "GET", "path": "/store/products/{{products.products.0.id}}?locale=fr-FR&fields=id,title,variants.id,variants.title", "delay_ms": 500, "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "store_fr_2", "method": "GET", "path": "/store/products/{{products.products.0.id}}?locale=fr-FR&fields=id,title,variants.id,variants.title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "admin_list_1", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "admin_list_2", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "admin_list_new_1", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.variants.1.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "create_variant2_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "create": [{ "reference_id": "{{products.products.0.variants.1.id}}", "reference": "product_variant", "locale_code": "fr-FR", "translations": { "title": "Moyen" } }] } },
  { "name": "store_fr_new", "method": "GET", "path": "/store/products/{{products.products.0.id}}?locale=fr-FR&fields=id,title,variants.id,variants.title", "delay_ms": 500, "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "admin_list_new_2", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.variants.1.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "cart_1", "method": "POST", "path": "/store/carts?fields=id,locale", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" }, "body": { "region_id": "{{regions.regions.0.id}}", "locale": "fr-FR" } },
  { "name": "item_1", "method": "POST", "path": "/store/carts/{{cart_1.cart.id}}/line-items?fields=id,items.product_title,items.variant_title,items.title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" }, "body": { "variant_id": "{{products.products.0.variants.0.id}}", "quantity": 1 } },
  { "name": "update_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "update": [{ "id": "{{create_fr.created.0.id}}", "translations": { "title": "Titre B" } }] } },
  { "name": "update_variant_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "update": [{ "id": "{{create_variant_fr.created.0.id}}", "translations": { "title": "Variante B" } }] } },
  { "name": "store_fr_3", "method": "GET", "path": "/store/products/{{products.products.0.id}}?locale=fr-FR&fields=id,title,variants.id,variants.title", "delay_ms": 500, "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "admin_list_3", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "cart_2", "method": "POST", "path": "/store/carts?fields=id,locale", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" }, "body": { "region_id": "{{regions.regions.0.id}}", "locale": "fr-FR" } },
  { "name": "item_2", "method": "POST", "path": "/store/carts/{{cart_2.cart.id}}/line-items?fields=id,items.product_title,items.variant_title,items.title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" }, "body": { "variant_id": "{{products.products.0.variants.0.id}}", "quantity": 1 } },
  { "name": "delete_fr", "method": "POST", "path": "/admin/translations/batch", "bearer": "login", "body": { "delete": ["{{create_fr.created.0.id}}"] } },
  { "name": "store_fr_4", "method": "GET", "path": "/store/products/{{products.products.0.id}}?locale=fr-FR&fields=id,title,variants.id,variants.title", "delay_ms": 500, "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "admin_list_4", "method": "GET", "path": "/admin/translations?reference_id={{products.products.0.id}}&fields=id,locale_code,translations", "bearer": "login" },
  { "name": "cart_locale", "method": "POST", "path": "/store/carts/{{cart_1.cart.id}}?fields=id,locale,items.product_title,items.variant_title,items.title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" }, "body": { "locale": "fr-FR" } }
]
