   "quantity": 1
  }
 },
 {
  "name": "shipping",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method",
  "body": {
   "shipping_option_id": "{{so_return.shipping_option.id}}",
   "custom_amount": 3
  }
 },
 {
  "name": "ship_update",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method/{{shipping.order_preview.shipping_methods.1.actions.0.id}}",
  "body": {
   "custom_amount": 4,
   "internal_note": "cheaper"
  }
 },
 {
  "name": "ship_update_null",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method/{{shipping.order_preview.shipping_methods.1.actions.0.id}}",
  "body": {
   "custom_amount": null
  }
 },
 {
  "name": "ship_update_wrong",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method/{{request_items.order_preview.items.0.actions.0.id}}",
  "body": {
   "custom_amount": 1
  }
 },
 {
  "name": "req_remove",
