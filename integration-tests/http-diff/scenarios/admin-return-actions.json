    {
     "id": "{{complete.order.items.0.id}}",
     "quantity": 2
    }
   ]
  }
 },
 {
  "name": "shipping2",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method",
  "body": {
   "shipping_option_id": "{{so_return.shipping_option.id}}"
  }
 },
 {
  "name": "ship_remove",
  "method": "DELETE",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/shipping-method/{{shipping2.order_preview.shipping_methods.1.actions.0.id}}"
 },
 {
  "name": "confirm",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/request"
 },
 {
  "name": "receive_begin",
  "method": "POST",
