  "path": "/admin/returns/{{begin.return.id}}/request-items/{{request_items.order_preview.items.0.actions.0.id}}"
 },
 {
  "name": "return_after_remove",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}?fields=id,status,location_id,metadata,no_notification"
 },
 {
  "name": "request_items2",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/returns/{{begin.return.id}}/request-items",
  "body": {
