[
 {
  "name": "login",
  "method": "POST",
  "path": "/auth/user/emailpass",
  "body": {
   "email": "admin@medusa-test.com",
   "password": "supersecret"
  }
 },
 {
  "name": "pk",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys",
  "body": {
   "title": "Store",
   "type": "publishable"
  }
 },
 {
  "name": "channels",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/sales-channels?order=name&fields=id,name"
 },
 {
  "name": "link",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
  "body": {
   "add": [
    "{{channels.sales_channels.0.id}}"
   ]
  }
 },
 {
  "name": "regions",
  "method": "GET",
  "path": "/store/regions?order=name&fields=id,name",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  }
 },
 {
  "name": "products",
  "method": "GET",
  "path": "/store/products?fields=id,title,variants.id,variants.sku&order=title",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  }
 },
 {
  "name": "tax_region",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/tax-regions?country_code=de&fields=id"
 },
 {
  "name": "rate_default",
  "method": "POST",
  "bearer": "login",
  "path": "/admin/tax-rates?fields=id",
  "body": {
   "tax_region_id": "{{tax_region.tax_regions.0.id}}",
   "name": "DE VAT",
   "code": "DE19",
   "rate": 19,
   "is_default": true
  }
 },
 {
  "name": "cart",
  "method": "POST",
  "path": "/store/carts?fields=id,total,items.id,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
   "region_id": "{{regions.regions.0.id}}",
   "email": "sse@example.test",
   "shipping_address": {
    "country_code": "de"
   }
  }
 },
 {
  "name": "events_add",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/add-to-cart/subscribe",
  "sse_until": "onFinish",
  "parallel": "g1",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ],
  "unordered": [
   "events"
  ]
 },
 {
  "name": "add",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/line-items?fields=id,total,items.id,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "parallel": "g1",
  "delay_ms": 1500,
  "body": {
   "variant_id": "{{products.products.1.variants.0.id}}",
   "quantity": 2
  }
 },
 {
  "name": "events_update_item",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/update-line-item-in-cart/subscribe",
  "sse_until": "onFinish",
  "parallel": "g2",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ],
  "unordered": [
   "events"
  ]
 },
 {
  "name": "update_item",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/line-items/{{add.cart.items.0.id}}?fields=id,total,items.id,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "parallel": "g2",
  "delay_ms": 1500,
  "body": {
   "quantity": 3
  }
 },
 {
  "name": "events_update_cart",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/update-cart/subscribe",
  "sse_until": "onFinish",
  "parallel": "g3",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ],
  "unordered": [
   "events"
  ]
 },
 {
  "name": "update_cart",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}?fields=id,total,items.id,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "parallel": "g3",
  "delay_ms": 1500,
  "body": {
   "region_id": "{{regions.regions.0.id}}",
   "email": "sse2@example.test"
  }
 },
 {
  "name": "events_promotions",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/update-cart-promotions/subscribe",
  "sse_until": "onFinish",
  "parallel": "g4",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ],
  "unordered": [
   "events"
  ]
 },
 {
  "name": "promotions",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/promotions?fields=id,total,items.id,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "parallel": "g4",
  "delay_ms": 1500,
  "body": {
   "promo_codes": []
  }
 },
 {
  "name": "events_delete_item",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/delete-line-items/subscribe",
  "sse_until": "onFinish",
  "parallel": "g5",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack"
  ],
  "unordered": [
   "events"
  ]
 },
 {
  "name": "delete_item",
  "method": "DELETE",
  "path": "/store/carts/{{cart.cart.id}}/line-items/{{add.cart.items.0.id}}",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "parallel": "g5",
  "delay_ms": 1500
 }
]