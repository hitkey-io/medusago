  {
    "name": "product",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/products?fields=id,variants.id,variants.inventory_items.inventory_item_id",
    "body": {
      "title": "Inventoryless",
      "status": "published",
      "shipping_profile_id": "{{profiles.shipping_profiles.0.id}}",
      "sales_channels": [
        {
          "id": "{{channels.sales_channels.0.id}}"
        }
      ],
      "options": [
        {
          "title": "Size",
          "values": [
            "One"
          ]
        }
      ],
      "variants": [
        {
          "title": "One",
          "sku": "INVLESS-ONE",
          "manage_inventory": true,
          "options": {
            "Size": "One"
          },
          "prices": [
            {
              "amount": 12,
              "currency_code": "eur"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "unlink_inventory",
    "method": "DELETE",
    "bearer": "login",
    "path": "/admin/products/{{product.product.id}}/variants/{{product.product.variants.0.id}}/inventory-items/{{product.product.variants.0.inventory_items.0.inventory_item_id}}?fields=id"
  },
  {
    "name": "add_inventoryless",
    "method": "POST",
    "path": "/store/carts/{{cart2.cart.id}}/line-items",
