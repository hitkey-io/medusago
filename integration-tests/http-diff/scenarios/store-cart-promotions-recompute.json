      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "variant_id": "{{product.product.variants.0.id}}",
      "quantity": 1
    }
  },
  {
    "name": "create_inventoryless",
    "method": "POST",
    "path": "/store/carts?fields=id",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
