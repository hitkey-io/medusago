  "name": "taxes",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/taxes?fields=id,email,customer_id,customer.email,total,tax_total,items.tax_lines.rate,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {}
 },
 {
  "name": "taxes_fields",
  "method": "POST",
  "path": "/store/carts/{{cart.cart.id}}/taxes",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {
   "fields": "id"
  }
 },
 {
  "name": "taxes_missing",
  "method": "POST",
  "path": "/store/carts/cart_missing/taxes",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {}
 },
 {
  "name": "pc_get",
  "method": "GET",
  "path": "/store/carts/{{cart.cart.id}}?fields=id,payment_collection.payment_sessions.id",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  }
 },
 {
  "name": "session_update",
  "method": "POST",
  "path": "/store/payment-collections/{{pc.payment_collection.id}}/payment-sessions/{{pc_get.cart.payment_collection.payment_sessions.0.id}}?fields=id,payment_sessions.id,payment_sessions.data,payment_sessions.status,payment_sessions.amount",
  "headers": {
