  "method": "POST",
  "path": "/store/carts/{{guest_cart.cart.id}}/customer?fields=id,email,customer_id,customer.email,total,tax_total,items.tax_lines.rate,items.quantity",
  "headers": {
   "x-publishable-api-key": "{{pk.api_key.token}}"
  },
  "body": {},
  "bearer": "customer_login"
 },
 {
