        "name": "up_good.csv",
        "type": "text/csv",
        "content": "Product Id,Product Handle,Product Title,Product Status,Product Description,Product Tag 1,Product Metadata,Variant Id,Variant Title,Variant Sku,Variant Manage Inventory,Variant Price EUR,Variant Price Europe [EUR],Variant Option 1 Name,Variant Option 1 Value,Variant Weight\n,import-cap,Import Cap,published,\"A cap, imported\",,\"{\"\"source\"\":\"\"csv\"\"}\",,One Size,IMP-CAP-1,false,15,14,Size,One,120\nprod_01M70XZZZ49MK9W0NV0YSF74CE,hoodie,Imported Hoodie,draft,,,,variant_01M70Y000G904MD1KJ0SDSRS44,Default,HOODIE-DEF,true,30,,Default option,Default option value,\n"
      }
    ]
  },
  {
    "name": "import_good",
