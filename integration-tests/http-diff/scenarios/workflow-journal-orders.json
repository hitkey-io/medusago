 {
  "name": "events_run_fulfill_bad",
  "method": "GET",
  "bearer": "login",
  "path": "/admin/workflows-executions/create-order-fulfillment/subscribe",
  "sse_until": "onFinish",
  "parallel": "g1",
  "ignore": [
   "events.*.step.invoke",
   "events.*.step.compensate",
   "events.*.errors.*.error.stack",
