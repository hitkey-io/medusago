  },
  "body": {
   "region_id": "{{regions.regions.0.id}}",
   "shipping_address": {
    "first_name": "Test",
    "last_name": "Buyer",
    "address_1": "Example Street 1",
    "country_code": "de",
    "city": "Berlin",
    "postal_code": "10115"
   },
