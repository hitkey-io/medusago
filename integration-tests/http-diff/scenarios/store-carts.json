[
  {
    "name": "login",
    "method": "POST",
    "path": "/auth/user/emailpass",
    "body": {
      "email": "admin@medusa-test.com",
      "password": "supersecret"
    }
  },
  {
    "name": "pk",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys",
    "body": {
      "title": "Store",
      "type": "publishable"
    }
  },
  {
    "name": "channels",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/sales-channels?order=name&fields=id,name"
  },
  {
    "name": "link",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels?fields=id",
    "body": {
      "add": [
        "{{channels.sales_channels.0.id}}"
      ]
    }
  },
  {
    "name": "regions",
    "method": "GET",
    "path": "/store/regions?order=name&fields=id,name",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "products",
    "method": "GET",
    "path": "/store/products?fields=id,title,variants.id,variants.sku&order=title",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "tax_region",
    "method": "GET",
    "bearer": "login",
    "path": "/admin/tax-regions?country_code=de&fields=id"
  },
  {
    "name": "rate_default",
    "method": "POST",
    "bearer": "login",
    "path": "/admin/tax-rates?fields=id",
    "body": {
      "tax_region_id": "{{tax_region.tax_regions.0.id}}",
      "name": "DE VAT",
      "code": "DE19",
      "rate": 19,
      "is_default": true
    }
  },
  {
    "name": "create_empty",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}"
    }
  },
  {
    "name": "create_no_region",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {}
  },
  {
    "name": "create_bad_currency",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "currency_code": "usd"
    }
  },
  {
    "name": "create_bad_quantity",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "items": [
        {
          "variant_id": "x",
          "quantity": 0
        }
      ]
    }
  },
  {
    "name": "create_bad_variant",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "items": [
        {
          "variant_id": "variant_missing",
          "quantity": 1
        }
      ]
    }
  },
  {
    "name": "create_unknown_field",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "foo": 1
    }
  },
  {
    "name": "create_bad_channel",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "sales_channel_id": "sc_other"
    }
  },
  {
    "name": "create_items",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "email": "guest@example.test",
      "shipping_address": {
        "country_code": "de",
        "city": "Berlin",
        "first_name": "Guest"
      },
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 2
        },
        {
          "variant_id": "{{products.products.0.variants.0.id}}",
          "quantity": 1,
          "metadata": {
            "gift": true
          }
        }
      ],
      "metadata": {
        "source": "test"
      }
    }
  },
  {
    "name": "get",
    "method": "GET",
    "path": "/store/carts/{{create_items.cart.id}}",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "get_fields",
    "method": "GET",
    "path": "/store/carts/{{create_items.cart.id}}?fields=id,total,items.id,items.total,items.tax_lines.rate,shipping_address.city",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "get_missing",
    "method": "GET",
    "path": "/store/carts/cart_missing",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    }
  },
  {
    "name": "create_usd",
    "method": "POST",
    "path": "/store/carts?fields=id,currency_code,region_id,shipping_address.country_code,total",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.1.id}}"
    }
  },
  {
    "name": "create_too_many",
    "method": "POST",
    "path": "/store/carts",
    "headers": {
      "x-publishable-api-key": "{{pk.api_key.token}}"
    },
    "body": {
      "region_id": "{{regions.regions.0.id}}",
      "items": [
        {
          "variant_id": "{{products.products.1.variants.0.id}}",
          "quantity": 1000
        }
      ]
    }
  }
]