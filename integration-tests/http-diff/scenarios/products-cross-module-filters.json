  { "name": "pl_and_q", "method": "GET", "bearer": "login", "path": "/admin/products?price_list_id[]={{lists.price_lists.1.id}}&q=shirt&order=title&fields=id,title" },
  { "name": "pl_and_sc", "method": "GET", "bearer": "login", "path": "/admin/products?price_list_id[]={{lists.price_lists.1.id}}&sales_channel_id={{channel2.sales_channel.id}}&order=title&fields=id,title" },
  { "name": "pl_count", "method": "GET", "bearer": "login", "path": "/admin/products?price_list_id[]={{lists.price_lists.1.id}}&limit=1&order=title&fields=id" },
  { "name": "sc2", "method": "GET", "bearer": "login", "path": "/admin/products?sales_channel_id={{channel2.sales_channel.id}}&order=title&fields=id,title" },
  { "name": "sc_both", "method": "GET", "bearer": "login", "path": "/admin/products?sales_channel_id[]={{channel2.sales_channel.id}}&sales_channel_id[]={{channels.sales_channels.0.id}}&order=title&fields=id,title" },
  { "name": "sc_missing", "method": "GET", "bearer": "login", "path": "/admin/products?sales_channel_id=sc_missing&fields=id" },
  { "name": "sc_with_relation", "method": "GET", "bearer": "login", "path": "/admin/products?sales_channel_id={{channel2.sales_channel.id}}&fields=id,*sales_channels" },
  { "name": "pk", "method": "POST", "bearer": "login", "path": "/admin/api-keys", "body": { "title": "Storefront", "type": "publishable" } },
  { "name": "pk_channels", "method": "POST", "bearer": "login", "path": "/admin/api-keys/{{pk.api_key.id}}/sales-channels", "body": { "add": ["{{channel2.sales_channel.id}}", "{{channels.sales_channels.0.id}}"] } },
  { "name": "store_sc2", "method": "GET", "path": "/store/products?sales_channel_id={{channel2.sales_channel.id}}&order=title&fields=id,title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "store_all", "method": "GET", "path": "/store/products?order=title&fields=id,title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
