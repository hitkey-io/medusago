  { "name": "store_detail_sc2", "method": "GET", "path": "/store/products/{{all.products.1.id}}?sales_channel_id={{channel2.sales_channel.id}}&fields=id,title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "store_detail_sc2_miss", "method": "GET", "path": "/store/products/{{all.products.2.id}}?sales_channel_id={{channel2.sales_channel.id}}&fields=id,title", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "store_variants_sc2", "method": "GET", "path": "/store/product-variants?sales_channel_id={{channel2.sales_channel.id}}&order=sku&fields=id,sku", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
  { "name": "store_variants_sc2_sku", "method": "GET", "path": "/store/product-variants?sales_channel_id={{channel2.sales_channel.id}}&sku={{all.products.1.variants.0.sku}}&fields=id,sku", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
