  { "name": "store_variant_detail_sc2", "method": "GET", "path": "/store/product-variants/{{all.products.1.variants.0.id}}?sales_channel_id={{channel2.sales_channel.id}}&fields=id,sku", "headers": { "x-publishable-api-key": "{{pk.api_key.token}}" } },
